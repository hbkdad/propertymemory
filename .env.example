# Copy to .env.local and fill in real values. Never commit .env.local (see .gitignore).

# Supabase project connection (Settings -> API in the Supabase dashboard,
# or `get_project_url` / `get_publishable_keys` via the Supabase MCP connector).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only. NEVER expose this to the client or prefix it with NEXT_PUBLIC_.
# Used only for privileged server-side operations (e.g. verifying webhooks) --
# ordinary reads/writes should go through the publishable key + RLS instead.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Paid AI/OCR extraction providers are optional (ADR 0004) -- the app must
# work with none of these set, using the free/local extraction baseline.
# EXTRACTION_PROVIDER=local
# OPENAI_API_KEY=
